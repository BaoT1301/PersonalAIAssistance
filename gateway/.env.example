# Gateway configuration. Set these as environment variables before `mvn spring-boot:run`
# (Spring Boot reads them from the environment). Example on Windows PowerShell:
#   $env:FUSIONAI_JWT_SECRET="..."; mvn spring-boot:run

# FastAPI backend the gateway proxies /api/** to.
FUSIONAI_BACKEND_URL=http://localhost:5001

# JWT signing secret — MUST be at least 32 characters. Use a long random value.
FUSIONAI_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
FUSIONAI_JWT_EXPIRY_MINUTES=1440

# Shared secret forwarded to FastAPI so it trusts only this gateway.
# Must match GATEWAY_SHARED_SECRET on the FastAPI side. Blank = don't send it.
FUSIONAI_GATEWAY_SECRET=

# Allowed frontend origins for CORS.
FUSIONAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-user rate limits (requests per minute).
FUSIONAI_RATELIMIT_DEFAULT=120
FUSIONAI_RATELIMIT_LLM=20
