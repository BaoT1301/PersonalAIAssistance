# Frontend configuration. All values are optional; the defaults run the app
# directly against FastAPI with no gateway and no login. Copy to .env to override.

# Production — set VITE_API_URL to your deployed backend/gateway origin.
# Development — leave unset; the Vite proxy handles routing.
VITE_API_URL=
VITE_WORKSPACE_ID=web-client

# Proxy target for the Vite dev/preview server. Both /api and /auth are proxied
# here. Leave as FastAPI for direct dev, or point at the gateway (http://localhost:8080)
# to route through auth + rate limiting.
BACKEND_URL=http://localhost:5001

# Require login: shows the sign-in screen and gates the chat behind an account.
# Works with the backend's native auth (/auth/register, /auth/login) — or with the
# gateway if BACKEND_URL points at it. Pair with AUTH_REQUIRED=true on the backend.
VITE_AUTH_ENABLED=false
