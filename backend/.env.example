# App
APP_NAME=FusionAI
ENVIRONMENT=development
PORT=5001
DEFAULT_WORKSPACE_ID=anonymous
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
REQUEST_LOGGING_ENABLED=true

# OpenAI
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=2000
OPENAI_TIMEOUT_SECONDS=60

# API gateway (optional). When set, FastAPI only accepts requests carrying this
# secret from the Spring Boot gateway, and takes the user from X-Fusion-User.
# Must match FUSIONAI_GATEWAY_SECRET on the gateway. Leave blank for direct dev.
GATEWAY_SHARED_SECRET=

# Railway PostgreSQL
# Railway will provide this automatically after you attach a Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/railway
AUTO_CREATE_TABLES=false
RUN_MIGRATIONS_ON_START=true

# Optional Redis cache
REDIS_URL=
CACHE_TTL_SECONDS=1800
LOCAL_CACHE_ENABLED=true

# Source retrieval
SOURCE_LOOKUP_ENABLED=true
WIKIPEDIA_RESULTS=1
WEB_SEARCH_RESULTS=3
SOURCE_TIMEOUT_SECONDS=6

# Document RAG (retrieval over uploaded files). Needs a valid OPENAI_API_KEY;
# falls back to whole-document context if embeddings are unavailable.
RAG_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARS=50000
